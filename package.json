{
  "name": "claudecraft",
  "private": true,
  "version": "1.3.0-beta",
  "description": "ClaudeCraft — a browser voxel survival game (Vite + three.js, 100% procedural assets), built from a written spec by AI. Fan-made, not affiliated with Mojang/Microsoft.",
  "type": "module",
  "scripts": {
    "predev": "node scripts/gen-theme-manifest.mjs",
    "dev": "vite",
    "prebuild": "node scripts/gen-theme-manifest.mjs --build",
    "build": "vite build",
    "prepreview": "node scripts/gen-theme-manifest.mjs --build",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs",
    "verify": "node scripts/smoke.mjs && vite build",
    "relay": "node server/relay.js"
  },
  "dependencies": {
    "three": "0.185.1",
    "simplex-noise": "^4.0.3",
    "alea": "^1.0.1"
  },
  "devDependencies": {
    "vite": "^8.1.4",
    "ws": "^8.20.1"
  }
}
